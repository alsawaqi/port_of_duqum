# Copy this file to a deployment-managed .env outside source control.
# Every value containing CHANGE_ME must be replaced before production starts.

CI_ENVIRONMENT = production
PODC_BASE_URL = "https://portal.example.om/port_of_duqum/"

# Generate independent secrets with a cryptographically secure generator.
# Do not reuse a value between settings. Existing encrypted URL identifiers
# must be migrated before changing an already deployed application key.
PODC_APP_ENCRYPTION_KEY = "CHANGE_ME_AT_LEAST_32_RANDOM_BYTES"

# Least-privilege database account. Enable TLS for a remote database host.
database.default.hostname = "127.0.0.1"
database.default.database = "CHANGE_ME_DATABASE"
database.default.username = "CHANGE_ME_APP_USER"
database.default.password = "CHANGE_ME_STRONG_DATABASE_PASSWORD"
database.default.DBDriver = "MySQLi"
database.default.DBPrefix = "pod_"
database.default.port = 3306
database.default.encrypt = false

# MFA/OTP is deferred for the current release. Keep disabled until the approved
# iBulk/email activation gate is completed and tested.
AUTH_SECURITY_MFA_ENABLED = false
AUTH_SECURITY_MFA_USER_TYPES = "staff,vendor"
AUTH_SECURITY_MFA_PROVIDER = "ibulk"
AUTH_SECURITY_MFA_PROVIDER_MAP = "staff:ibulk,vendor:email"
AUTH_SECURITY_MFA_HMAC_KEY = "CHANGE_ME_INDEPENDENT_32_BYTE_RANDOM_SECRET"
AUTH_SECURITY_MFA_IBULK_ENDPOINT = "https://www.ismartsms.net/iBulkSMS/HttpWS/SMSDynamicRefIntlAPI.aspx"
AUTH_SECURITY_MFA_IBULK_USER_ID = "CHANGE_ME"
AUTH_SECURITY_MFA_IBULK_PASSWORD = "CHANGE_ME"
AUTH_SECURITY_MFA_IBULK_HEADER = "CHANGE_ME_APPROVED_SENDER"
AUTH_SECURITY_MFA_IBULK_CONNECT_TIMEOUT_SECONDS = 3
AUTH_SECURITY_MFA_IBULK_TIMEOUT_SECONDS = 8

# Google reCAPTCHA. Bind responses to the exact public hostname.
PODC_RECAPTCHA_PROTOCOL = "v2"
PODC_RECAPTCHA_SITE_KEY = "CHANGE_ME"
PODC_RECAPTCHA_SECRET_KEY = "CHANGE_ME"
PODC_RECAPTCHA_EXPECTED_HOSTNAME = "portal.example.om"
PODC_RECAPTCHA_EXPECTED_ACTION = "submit"
PODC_RECAPTCHA_MIN_SCORE = 0.5

# E-service fee collection. Keep disabled until live Stripe credentials and
# the signed webhook endpoint have been verified end to end.
eservices.payment.provider = "disabled"
eservices.payment.currency = "OMR"
eservices.payment.stripeSecretKey = "CHANGE_ME"
eservices.payment.stripeWebhookSecret = "CHANGE_ME"
eservices.payment.checkoutTtlSeconds = 1800
eservices.payment.webhookToleranceSeconds = 300

# Three-person tender opening code vault. CHANGE_ME is intentionally invalid;
# inject two independent base64: values through the production secret manager.
TENDER_OPENING_CODE_HMAC_KEY = "CHANGE_ME"
TENDER_OPENING_CODE_ENCRYPTION_KEY = "CHANGE_ME"

# Signed internal workers. Leave the notification HTTP endpoint unused when
# notifications are processed in-process.
PODC_CRON_KEY = "CHANGE_ME_INDEPENDENT_32_BYTE_RANDOM_SECRET"
PODC_NOTIFICATION_PROCESSOR_KEY = "CHANGE_ME_INDEPENDENT_32_BYTE_RANDOM_SECRET"
PODC_FILE_STREAM_HMAC_KEY = "CHANGE_ME_INDEPENDENT_32_BYTE_RANDOM_SECRET"

# Legacy RISE integration callbacks are disabled by default. If explicitly
# enabled, every configured provider requires a body-signing secret.
PODC_LEGACY_WEBHOOKS_ENABLED = false
PODC_GITHUB_WEBHOOK_SECRET = "CHANGE_ME_INDEPENDENT_32_BYTE_RANDOM_SECRET"
PODC_BITBUCKET_WEBHOOK_SECRET = "CHANGE_ME_INDEPENDENT_32_BYTE_RANDOM_SECRET"
PODC_STRIPE_INVOICE_WEBHOOK_SECRET = "CHANGE_ME_INDEPENDENT_32_BYTE_RANDOM_SECRET"
PODC_STRIPE_SUBSCRIPTION_WEBHOOK_SECRET = "CHANGE_ME_INDEPENDENT_32_BYTE_RANDOM_SECRET"

# Uploads fail closed in production unless the malware-scanning hook returns a
# positive clean result. Keep this true on production.
UPLOAD_MALWARE_SCAN_FAIL_CLOSED = true

# Optional HTTPS endpoint that receives CSP violation reports.
PODC_CSP_REPORT_URI = "https://security.example.om/csp-report"
