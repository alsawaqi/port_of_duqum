#!/usr/bin/env php
<?php

/**
 * CodeIgniter command-line entry point adapted for this legacy root-webroot
 * layout. Keep its PHP minimum and boot path aligned with index.php.
 */

use CodeIgniter\Boot;
use Config\Paths;

if (str_starts_with(PHP_SAPI, 'cgi')) {
    exit("The CLI tool requires php-cli and cannot run under php-cgi.\n\n");
}

$minPhpVersion = '8.1.34'; // Keep aligned with the project compatibility build in index.php.
if (version_compare(PHP_VERSION, $minPhpVersion, '<')) {
    exit(sprintf(
        "PHP %s or later is required. Current version: %s\n",
        $minPhpVersion,
        PHP_VERSION
    ));
}

error_reporting(E_ALL);
ini_set('display_errors', '1');

define('FCPATH', __DIR__ . DIRECTORY_SEPARATOR);
if (getcwd() . DIRECTORY_SEPARATOR !== FCPATH) {
    chdir(FCPATH);
}

require FCPATH . 'app/Config/Paths.php';

$paths = new Paths();
require $paths->systemDirectory . '/Boot.php';

exit(Boot::bootSpark($paths));
